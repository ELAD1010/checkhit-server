# Public hostname of this server. Caddy gets a Let's Encrypt certificate for it.
# Its DNS A record must point at this machine, and ports 80/443 must be open.
API_DOMAIN=api.example.com

# Your Vercel frontend, without a trailing slash
FRONTEND_URL=https://your-app.vercel.app

# Postgres (DB_HOST/DB_PORT are set by docker-compose.yml)
DB_USER=checkhit
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=checkhit
LTI_DB_NAME=checkhit_lti

# Long random string, e.g. `openssl rand -hex 32`
LTI_ENCRYPTION_KEY=change-me

# Moodle
MOODLE_URL=https://your-moodle.example.com
MOODLE_CLIENT_ID=
MOODLE_WS_TOKEN=

# AI grading
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_BYTES=20971520
GRADING_WORKER_ENABLED=true
GRADING_WORKER_POLL_INTERVAL_MS=2000
GRADING_WORKER_MAX_ATTEMPTS=3
