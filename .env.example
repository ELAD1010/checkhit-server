# Server
PORT=3001
FRONTEND_URL=http://localhost:5173/lecturer
NODE_ENV=development

# Postgres
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkhit
LTI_DB_NAME=moodle

# LTI / Moodle
LTI_ENCRYPTION_KEY=replace_with_a_long_secret
MOODLE_URL=http://localhost
MOODLE_CLIENT_ID=replace_me
MOODLE_WS_TOKEN=replace_me

# Gemini grading
GEMINI_MODEL=gemini-2.5-flash
GRADING_PROMPT_VERSION=grading-v2
QUESTION_IMPORT_PROMPT_VERSION=question-import-v2

# Local file storage
FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=20971520

# Async grading worker
GRADING_WORKER_ENABLED=true
GRADING_WORKER_POLL_INTERVAL_MS=2000
GRADING_WORKER_MAX_ATTEMPTS=3
